{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/module.schema.json",
  "title": "TianGong PCR reusable methodology module",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "status",
    "title",
    "description",
    "depends_on",
    "applicability",
    "parameters",
    "boundary_rules",
    "inventory_patterns",
    "collection_protocols",
    "calculation_rules",
    "allocation_rules",
    "validation_rules",
    "data_quality_rules",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^module\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "status": {
      "enum": ["candidate", "active", "deprecated"]
    },
    "title": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "depends_on": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "applicability": { "$ref": "#/$defs/applicability" },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "boundary_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/boundaryRule" }
    },
    "inventory_patterns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/inventoryPattern" }
    },
    "collection_protocols": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/collectionProtocol" }
    },
    "calculation_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/calculationRule" }
    },
    "allocation_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/allocationRule" }
    },
    "validation_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/validationRule" }
    },
    "data_quality_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/qualityRule" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "uniqueStrings": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "sourceIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en-US", "zh-CN"],
      "properties": {
        "en-US": { "$ref": "#/$defs/nonEmptyString" },
        "zh-CN": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains", "subjects", "excluded_activities"],
      "properties": {
        "domains": { "$ref": "#/$defs/uniqueStrings" },
        "subjects": { "$ref": "#/$defs/uniqueStrings" },
        "excluded_activities": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "version"],
      "properties": {
        "module_id": {
          "type": "string",
          "pattern": "^module\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "label", "description", "data_type", "unit", "required", "supplied_by", "source_ids"],
      "properties": {
        "parameter_id": { "$ref": "#/$defs/identifier" },
        "label": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "data_type": { "enum": ["number", "string", "boolean", "enum"] },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "required": { "type": "boolean" },
        "supplied_by": { "enum": ["pcr", "foreground_dataset", "pcr_or_foreground_dataset"] },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "boundaryRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "inclusion", "activity", "rule", "source_ids"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/identifier" },
        "inclusion": { "enum": ["include", "conditional", "exclude"] },
        "activity": { "$ref": "#/$defs/identifier" },
        "rule": { "$ref": "#/$defs/localizedText" },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "inventoryPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern_id", "direction", "flow_type", "flow_role", "required", "amount_source", "collection_protocol_id", "condition", "source_ids"],
      "properties": {
        "pattern_id": { "$ref": "#/$defs/identifier" },
        "direction": { "enum": ["input", "output"] },
        "flow_type": { "enum": ["product", "waste", "elementary"] },
        "flow_role": { "$ref": "#/$defs/localizedText" },
        "required": { "type": "boolean" },
        "amount_source": { "enum": ["foreground_record", "calculated_from_collection", "method_formula", "site_specific"] },
        "collection_protocol_id": { "$ref": "#/$defs/identifier" },
        "condition": { "$ref": "#/$defs/localizedText" },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "collectionProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "applies_to", "record_type", "required_fields", "collection_method", "unit", "frequency", "temporal_coverage", "site_scope", "aggregation_rule", "quality_evidence", "source_ids"],
      "properties": {
        "protocol_id": { "$ref": "#/$defs/identifier" },
        "applies_to": { "$ref": "#/$defs/uniqueStrings" },
        "record_type": { "$ref": "#/$defs/localizedText" },
        "required_fields": { "$ref": "#/$defs/uniqueStrings" },
        "collection_method": { "$ref": "#/$defs/localizedText" },
        "unit": { "$ref": "#/$defs/nonEmptyString" },
        "frequency": { "$ref": "#/$defs/nonEmptyString" },
        "temporal_coverage": { "$ref": "#/$defs/localizedText" },
        "site_scope": { "$ref": "#/$defs/localizedText" },
        "aggregation_rule": { "$ref": "#/$defs/localizedText" },
        "quality_evidence": { "$ref": "#/$defs/uniqueStrings" },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "calculationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "applies_to", "expression", "inputs", "output", "output_unit", "source_ids"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/identifier" },
        "applies_to": { "$ref": "#/$defs/uniqueStrings" },
        "expression": { "$ref": "#/$defs/nonEmptyString" },
        "inputs": { "$ref": "#/$defs/uniqueStrings" },
        "output": { "$ref": "#/$defs/identifier" },
        "output_unit": { "$ref": "#/$defs/nonEmptyString" },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "allocationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "priority", "method", "rule", "condition", "source_ids"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/identifier" },
        "priority": { "type": "integer", "minimum": 1 },
        "method": { "$ref": "#/$defs/identifier" },
        "rule": { "$ref": "#/$defs/localizedText" },
        "condition": { "$ref": "#/$defs/localizedText" },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "validationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "severity", "check", "message", "source_ids"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/identifier" },
        "severity": { "enum": ["error", "warning"] },
        "check": { "$ref": "#/$defs/nonEmptyString" },
        "message": { "$ref": "#/$defs/localizedText" },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "qualityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "dimension", "requirement", "source_ids"],
      "properties": {
        "rule_id": { "$ref": "#/$defs/identifier" },
        "dimension": { "$ref": "#/$defs/identifier" },
        "requirement": { "$ref": "#/$defs/localizedText" },
        "source_ids": { "$ref": "#/$defs/sourceIds" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "type", "reference", "supports"],
      "properties": {
        "source_id": { "$ref": "#/$defs/identifier" },
        "type": { "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/source_type" },
        "reference": { "$ref": "#/$defs/nonEmptyString" },
        "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "supports": { "$ref": "#/$defs/uniqueStrings" }
      }
    }
  }
}
