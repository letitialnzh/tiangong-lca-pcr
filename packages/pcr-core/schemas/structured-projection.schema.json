{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.org/schemas/pcr/v1/structured-projection.schema.json",
  "title": "TianGong material PCR structured projection",
  "type": "object",
  "required": [
    "schema_version",
    "generated_from",
    "source_markdown",
    "product_category_identity",
    "functional_unit",
    "system_boundary",
    "boundary_abstraction",
    "reference_flow_definition",
    "reference_flows",
    "measurement_rules",
    "process_map",
    "process_inventory",
    "allocation_rules",
    "dataset_production",
    "validation_rules",
    "published_dataset_profile",
    "data_sources",
    "projection_metadata"
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "normativeRule": {
      "type": "object",
      "required": ["rule_id", "applies_to", "rule", "source_ids"],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "applies_to": { "$ref": "#/$defs/nonEmptyString" },
        "rule": { "$ref": "#/$defs/nonEmptyString" },
        "source_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "normativeRuleArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/normativeRule" }
    },
    "projectionMetadata": {
      "type": "object",
      "required": ["contract_version", "generator", "canonical_markdown", "generated_content_sha256"],
      "properties": {
        "contract_version": { "const": "1" },
        "generator": { "const": "tiangong-pcr-builder/markdown-projection" },
        "canonical_markdown": {
          "type": "object",
          "required": ["path", "normalization", "hash_algorithm", "sha256"],
          "properties": {
            "path": { "const": "pcr.en-US.md" },
            "normalization": { "const": "utf8-lf-v1" },
            "hash_algorithm": { "const": "sha256" },
            "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          },
          "additionalProperties": false
        },
        "generated_content_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "processMapEntry": {
      "type": "object",
      "required": ["id", "name", "inclusion", "inclusion_condition", "role", "quantitative_reference"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "inclusion": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/process_inclusion"
        },
        "inclusion_condition": { "type": "string" },
        "role": { "$ref": "#/$defs/nonEmptyString" },
        "quantitative_reference": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "amountBasis": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "text": { "type": "string" },
        "kind": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/basis_kind"
        }
      },
      "additionalProperties": false
    },
    "amountEvidence": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/evidence_kind"
        },
        "collection_protocol_id": { "type": "string" },
        "source_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "amountRange": {
      "type": "object",
      "required": ["role", "basis_kind", "evidence_kind"],
      "properties": {
        "role": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/amount_range_role"
        },
        "lower": { "type": "string" },
        "upper": { "type": "string" },
        "unit": { "type": "string" },
        "basis": { "type": "string" },
        "basis_kind": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/basis_kind"
        },
        "evidence_kind": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/evidence_kind"
        },
        "source_ids": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "flowAmount": {
      "type": "object",
      "required": ["value_mode", "specificity", "basis", "evidence", "ranges"],
      "properties": {
        "expression": { "type": "string" },
        "value_mode": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/amount_value_mode"
        },
        "specificity": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/amount_specificity"
        },
        "basis": { "$ref": "#/$defs/amountBasis" },
        "evidence": { "$ref": "#/$defs/amountEvidence" },
        "ranges": {
          "type": "array",
          "items": { "$ref": "#/$defs/amountRange" }
        }
      },
      "additionalProperties": false
    },
    "flowBinding": {
      "type": "string",
      "enum": ["fixed", "parameterized"]
    },
    "flowSetRef": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^flow-set\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "group": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "flowRow": {
      "type": "object",
      "required": [
        "row_id",
        "role",
        "name",
        "flow_type",
        "property_unit",
        "description",
        "amount"
      ],
      "properties": {
        "row_id": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "flow_type": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/flow_type"
        },
        "flow_ref": { "type": "object" },
        "binding": { "$ref": "#/$defs/flowBinding" },
        "flow_set_ref": { "$ref": "#/$defs/flowSetRef" },
        "property_unit": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "$ref": "#/$defs/flowAmount" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "required": ["binding"], "properties": { "binding": { "const": "fixed" } } },
          "then": {
            "required": ["flow_ref"],
            "properties": { "flow_ref": {} }
          }
        },
        {
          "if": { "required": ["binding"], "properties": { "binding": { "const": "parameterized" } } },
          "then": {
            "required": ["flow_set_ref"],
            "properties": { "flow_set_ref": {} },
            "not": { "required": ["flow_ref"] }
          }
        },
        {
          "if": { "required": ["flow_type"], "properties": { "flow_type": { "const": "elementary" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["flow_set_ref"] },
                { "required": ["binding"], "properties": { "binding": { "const": "parameterized" } } }
              ]
            }
          }
        }
      ]
    },
    "flowGroups": {
      "type": "object",
      "required": ["product", "waste", "elementary"],
      "properties": {
        "product": { "type": "array", "items": { "$ref": "#/$defs/flowRow" } },
        "waste": { "type": "array", "items": { "$ref": "#/$defs/flowRow" } },
        "elementary": { "type": "array", "items": { "$ref": "#/$defs/flowRow" } }
      },
      "additionalProperties": false
    },
    "processInventoryEntry": {
      "type": "object",
      "required": ["id", "label", "inputs", "outputs"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "inputs": { "$ref": "#/$defs/flowGroups" },
        "outputs": { "$ref": "#/$defs/flowGroups" }
      },
      "additionalProperties": false
    },
    "dataSource": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "$ref": "https://tiangong-lca.org/schemas/pcr/v1/controlled-vocabulary.schema.json#/$defs/source_type"
        },
        "reference": { "type": "string" },
        "used_for": { "type": "string" }
      },
      "additionalProperties": false
    },
    "moduleReference": {
      "type": "object",
      "required": ["id", "kind", "path", "decision"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^module\\.(activity|technology|system-condition)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": { "enum": ["activity", "technology", "system_condition"] },
        "path": {
          "type": "string",
          "pattern": "^library/modules/(activities|technologies|system-conditions)/[a-z0-9]+(?:-[a-z0-9]+)*\\.yaml$"
        },
        "decision": { "enum": ["applicable", "unresolved"] }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "generated_from": { "const": "markdown" },
    "source_markdown": { "const": "pcr.en-US.md" },
    "product_category_identity": {
      "type": "object",
      "properties": {
        "canonical_pcr_id": { "type": "string", "pattern": "^pcr\\." }
      },
      "additionalProperties": { "type": "string" }
    },
    "functional_unit": { "type": "object" },
    "system_boundary": {
      "type": "object",
      "required": ["rules"],
      "properties": { "rules": { "$ref": "#/$defs/normativeRuleArray" } },
      "additionalProperties": false
    },
    "boundary_abstraction": { "type": "object" },
    "reference_flow_definition": { "type": "object" },
    "reference_flows": { "type": "array" },
    "measurement_rules": { "type": "array", "items": { "type": "object" } },
    "process_map": {
      "type": "array",
      "items": { "$ref": "#/$defs/processMapEntry" }
    },
    "process_inventory": {
      "type": "array",
      "items": { "$ref": "#/$defs/processInventoryEntry" }
    },
    "allocation_rules": { "$ref": "#/$defs/normativeRuleArray" },
    "dataset_production": {
      "type": "object",
      "required": ["collection_protocols", "calculation_rules", "data_quality_requirements"],
      "properties": {
        "collection_protocols": { "type": "array" },
        "calculation_rules": { "type": "array" },
        "data_quality_requirements": { "type": "array" }
      },
      "additionalProperties": false
    },
    "validation_rules": { "$ref": "#/$defs/normativeRuleArray" },
    "published_dataset_profile": { "type": "object" },
    "module_references": {
      "type": "object",
      "required": ["selection_mode", "selected", "unresolved"],
      "properties": {
        "selection_mode": { "const": "automatic" },
        "selected": {
          "type": "array",
          "items": { "$ref": "#/$defs/moduleReference" }
        },
        "unresolved": {
          "type": "array",
          "items": { "$ref": "#/$defs/moduleReference" }
        }
      },
      "additionalProperties": false
    },
    "data_sources": { "type": "array", "items": { "$ref": "#/$defs/dataSource" } },
    "projection_metadata": { "$ref": "#/$defs/projectionMetadata" }
  },
  "additionalProperties": false
}
